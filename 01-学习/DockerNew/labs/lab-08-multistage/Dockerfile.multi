# syntax=docker/dockerfile:1.7

# ===== 多阶段构建（正确做法） =====
# 对应 DockerNew 第 8 章：多阶段构建 + 第 9 章：生产安全加固
# 镜像大小：~15MB（从 850MB 瘦到 15MB，减少 98%）

# ===== 构建阶段（可以很大，含编译器、源码） =====
FROM golang:1.22-alpine AS builder

WORKDIR /app

# 缓存友好：先 COPY go.mod（很少变，缓存命中）
COPY go.mod ./
RUN go mod download

# 最后 COPY 源码（常变，只影响这一层）
COPY main.go ./

# 静态编译 + 去掉调试信息
# CGO_ENABLED=0：静态编译，不依赖 glibc
# -ldflags="-s -w"：去掉符号表和调试信息，减小 ~30%
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /app/server .

# ===== 运行阶段（小镜像，只有二进制） =====
FROM alpine:3.20

# 安装 CA 证书（HTTPS 需要）
RUN apk add --no-cache ca-certificates

# 创建非 root 用户（对应 DockerNew 09 章：安全加固）
RUN addgroup -S app && adduser -S app -G app -u 1000

WORKDIR /app

# 只复制编译产物（编译器、源码不进最终镜像）
COPY --from=builder /app/server /app/server

# 切换到非 root 用户
USER 1000:1000

EXPOSE 8080

# exec 格式：PID 1 是应用本身，能接收 SIGTERM 优雅停止
ENTRYPOINT ["/app/server"]
